@{
    ViewData["Title"] = "Register App";
}

<h2>Register New App</h2>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>App Name</label>
        <input type="text" name="name" class="form-control" value="@ViewBag.Name" required />
        @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div class="mb-3">
        <label>Return URL</label>
        <input type="text" name="returnUrl" class="form-control" value="@ViewBag.ReturnUrl"
               placeholder="https://yourapp.com/sso/callback" required />
        @if (ViewData.ModelState["ReturnUrl"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["ReturnUrl"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <button type="submit" class="btn btn-primary">Save App</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>