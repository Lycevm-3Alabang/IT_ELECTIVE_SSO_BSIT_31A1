@{
    ViewData["Title"] = "Create Tenant App";
}

<a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Return to App List
</a>

<h4 class="mb-1">Create Tenant App</h4>
<p class="text-muted">Register a new application with IT ELECTIVE - SSO.</p>

<div class="admin-card" style="max-width: 640px;">
    <div class="admin-card-title">Application Information</div>

    <form method="post" asp-action="Create" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Application Name</label>
            <input type="text" name="name" class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                   value="@ViewBag.Name" placeholder="e.g. SalesApp" required />
            @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
            {
                <div class="invalid-feedback d-block">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</div>
            }
        </div>

        <div class="mb-4">
            <label class="form-label">Return URL</label>
            <input type="text" name="returnUrl" class="form-control @(ViewData.ModelState["ReturnUrl"]?.Errors.Count > 0 ? "is-invalid" : "")"
                   value="@ViewBag.ReturnUrl" placeholder="https://yourapp.com/sso/callback" required />
            @if (ViewData.ModelState["ReturnUrl"]?.Errors.Count > 0)
            {
                <div class="invalid-feedback d-block">@ViewData.ModelState["ReturnUrl"]!.Errors.First().ErrorMessage</div>
            }
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn admin-btn-primary">
                <i class="bi bi-plus-lg"></i> Create App
            </button>
        </div>
    </form>
</div>