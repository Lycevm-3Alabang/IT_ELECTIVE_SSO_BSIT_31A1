@model IEnumerable<Models.Entities.TenantApp>
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Tenant Apps";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">Tenant Apps</h4>
        <p class="text-muted mb-0">Manage applications registered with IT ELECTIVE - SSO.</p>
    </div>
    <a asp-action="Create" class="btn admin-btn-primary">
        <i class="bi bi-plus-lg"></i> Create App
    </a>
</div>

<div class="admin-card">
    <table class="table align-middle mb-0" id="appsTable">
        <thead>
            <tr>
                <th>Application</th>
                <th>Status</th>
                <th>Return URL</th>
                <th>Toggle</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No applications registered yet.</td>
                </tr>
            }
            @foreach (var app in Model)
            {
                <tr class="app-row" data-name="@app.Name?.ToLower()" data-status="@(app.IsActive ? "active" : "inactive")">
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="admin-row-icon"><i class="bi bi-window"></i></span>
                            <span class="fw-semibold">@app.Name</span>
                        </div>
                    </td>
                    <td>
                        <span id="status-label-@app.Id"
                              class="status-badge @(app.IsActive ? "status-badge-active" : "status-badge-inactive")">
                            @(app.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <a href="@app.ReturnUrl" target="_blank" rel="noopener" class="text-truncate d-inline-block" style="max-width:280px;">
                            @app.ReturnUrl
                        </a>
                    </td>
                    <td>
                        <!-- toggle switch -->
                        <label class="toggle-switch">
                            <input type="checkbox" class="toggle-active" data-app-id="@app.Id" checked="@(app.IsActive)" />
                        </label>
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <!-- Delete button -> opens modal -->
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-app-id="@app.Id" data-app-name="@app.Name">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteModalForm" method="post" action="/Admin/TenantApps/Delete/">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Delete App?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="deleteModalAppName"></strong>?
                    This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete App</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete Modal Handler
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const appId = button.getAttribute('data-app-id');
            const appName = button.getAttribute('data-app-name');
            document.getElementById('deleteModalForm').action = `/Admin/TenantApps/Delete/${appId}`;
            document.getElementById('deleteModalAppName').textContent = appName;
        });

        // Toggle Switch Active Status Handler
        document.querySelectorAll('.toggle-active').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                const appId = this.dataset.appId;
                const checkboxEl = this;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = { 'X-Requested-With': 'XMLHttpRequest' };
                if (tokenInput) headers['RequestVerificationToken'] = tokenInput.value;

                fetch(`/Admin/TenantApps/ToggleActive/${appId}`, { method: 'POST', headers: headers })
                    .then(function (res) {
                        if (!res.ok) throw new Error(`Request failed with status ${res.status}`);
                        return res.json();
                    })
                    .then(function (data) {
                        const label = document.getElementById(`status-label-${data.id}`);
                        label.textContent = data.isActive ? 'Active' : 'Inactive';
                        label.classList.toggle('status-badge-active', data.isActive);
                        label.classList.toggle('status-badge-inactive', !data.isActive);
                        checkboxEl.closest('tr').dataset.status = data.isActive ? 'active' : 'inactive';
                    })
                    .catch(function (error) {
                        console.error('Toggle failed:', error);
                        alert('Failed to update app status.');
                        checkboxEl.checked = !checkboxEl.checked;
                    });
            });
        });
    </script>
}