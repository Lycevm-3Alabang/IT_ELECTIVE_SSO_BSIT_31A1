<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT ELECTIVE SSO Gateway</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --sidebar-width: 260px;
            --bg-sidebar: #382943;
            --bg-sidebar-hover: #4a3858;
            --bg-main: #FAF8F5;
            --text-dark: #2D2535;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        /* Sidebar Styling */
        #sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            background-color: var(--bg-sidebar);
            color: #ffffff;
        }

        #sidebar .brand-box {
            padding: 1.5rem 1.25rem;
        }

        #sidebar .brand-icon {
            width: 38px;
            height: 38px;
            background-color: #ffffff;
            border-radius: 4px;
        }

        #sidebar .nav-link {
            color: #d1c9d7;
            padding: 0.85rem 1.5rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }

        #sidebar .nav-link:hover,
        #sidebar .nav-link.active {
            color: #ffffff;
            background-color: var(--bg-sidebar-hover);
        }

        #main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }

        /* Card Styling */
        .card-custom {
            background-color: #ffffff;
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .stat-icon-circle {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background-color: #382943;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .icon-circle-sm {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #f1ecf4;
            color: #382943;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Custom Progress Bars */
        .progress-custom-bg {
            background-color: #E8E3DD;
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
        }
        .progress-custom-fill {
            background-color: #382943;
            height: 100%;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div id="sidebar" class="d-flex flex-column justify-content-between">
        <div>
            <div class="brand-box d-flex align-items-center gap-3">
                <div class="brand-icon"></div>
                <div>
                    <h6 class="mb-0 fw-bold lh-1 text-white">IT ELECTIVE</h6>
                    <small class="text-white-50 fs-7">SSO Gateway</small>
                </div>
            </div>

            <ul class="nav flex-column mt-4">
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-chart-simple"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Users" ? "active" : "")">
                        <i class="fa-regular fa-user"></i> Users
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Groups" asp-action="Index"
                       class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Groups" ? "active" : "")">
                        <i class="fa-solid fa-user-group"></i> Groups
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Applications" asp-action="Index"
                       class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Applications" ? "active" : "")">
                        <i class="fa-regular fa-mobile"></i> Applications
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"
                       class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "AuditLogs" ? "active" : "")">
                        <i class="fa-regular fa-file-lines"></i> Audit Logs
                    </a>
                </li>
            </ul>
        </div>

        <div class="p-3">
            <a href="/Account/Logout" class="nav-link text-white-50 hover-white">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
            </a>
        </div>
    </div>

    <div id="main-wrapper">
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold tracking-tight">DASHBOARD</h5>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" data-bs-toggle="dropdown">
                    <div class="bg-light rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-regular fa-user text-secondary"></i>
                    </div>
                    <div class="text-start me-2">
                        <div class="fw-bold fs-7 lh-1">Admin User</div>
                        <small class="text-muted fs-8">Super Administrator</small>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#">Profile</a></li>
                    <li><a class="dropdown-item" href="#">Settings</a></li>
                </ul>
            </div>
        </header>

        <main class="p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>