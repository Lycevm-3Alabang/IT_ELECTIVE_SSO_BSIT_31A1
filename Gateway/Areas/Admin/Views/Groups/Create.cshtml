@{
    ViewData["Title"] = "Create Group";
}

<h2>Create Group</h2>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>App</label>
        <select name="tenantAppId" class="form-select" asp-items="ViewBag.Apps" required>
            <option value="">-- Select App --</option>
        </select>
        @if (ViewData.ModelState["TenantAppId"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["TenantAppId"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div class="mb-3">
        <label>Group Name <small class="text-muted">(app name will be auto-prefixed, e.g. "Admin" &rarr; "SalesApp-Admin")</small></label>
        <input type="text" name="name" class="form-control" value="@ViewBag.Name" required />
        @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div class="mb-3">
        <label>Power Level <small class="text-muted">(0 = highest power)</small></label>
        <input type="number" name="level" class="form-control" value="@(ViewBag.Level ?? 99)" min="0" max="99" required />
        @if (ViewData.ModelState["Level"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["Level"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <button type="submit" class="btn btn-primary">Save Group</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>