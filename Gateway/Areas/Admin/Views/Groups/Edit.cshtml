@model Models.Entities.Group
@{
    ViewData["Title"] = "Edit Group";
}

<h2>Edit Group</h2>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>App</label>
        <select name="tenantAppId" class="form-select" asp-items="ViewBag.Apps" required></select>
        @if (ViewData.ModelState["TenantAppId"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["TenantAppId"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div class="mb-3">
        <label>Group Name</label>
        <input type="text" name="name" class="form-control" value="@Model.Name" required />
        @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div class="mb-3">
        <label>Power Level</label>
        <input type="number" name="level" class="form-control" value="@Model.Level" min="0" max="99" required />
        @if (ViewData.ModelState["Level"]?.Errors.Count > 0)
        {
            <span class="text-danger">@ViewData.ModelState["Level"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>