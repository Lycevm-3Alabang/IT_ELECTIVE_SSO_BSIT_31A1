@{
    ViewData["Title"] = "Create User";
}

<h2>Create User</h2>

<form method="post" action="/Admin/Users/Create">
    @Html.AntiForgeryToken()
    <div>
        <label>Email:</label>
        <input type="email" name="email" value="@ViewBag.Email" required />
        @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
        {
            <span style="color:red;">@ViewData.ModelState["Email"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div>
        <label>Temporary Password:</label>
        <input type="password" name="password" required />
        @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
        {
            <span style="color:red;">@ViewData.ModelState["Password"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <div>
        <label>Confirm Password:</label>
        <input type="password" name="confirmPassword" required />
        @if (ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0)
        {
            <span style="color:red;">@ViewData.ModelState["ConfirmPassword"]!.Errors.First().ErrorMessage</span>
        }
    </div>
    <button type="submit">Save User</button>
</form>

<div style="color: red;">
    @Html.ValidationSummary()
</div>