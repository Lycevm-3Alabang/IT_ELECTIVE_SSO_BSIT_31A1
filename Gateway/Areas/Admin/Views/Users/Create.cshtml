<h2>Create User</h2>

<form method="post" action="/Admin/Users/Create">
    <div>
        <label>Email:</label>
        <input type="email" name="email" required />
    </div>
    <div>
        <label>Password:</label>
        <input type="password" name="password" required />
    </div>
    <button type="submit">Save User</button>
</form>

<div style="color: red;">
    @Html.ValidationSummary()
</div>