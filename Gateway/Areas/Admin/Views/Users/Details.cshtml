@model Gateway.Areas.Admin.Models.UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}
<h2>User Details</h2>

@if (TempData["TemporaryPassword"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>Password reset successfully. Share the temporary password below with the user.</span>
    </div>

    <div class="alert alert-warning">
        <label for="tempPasswordField" class="form-label mb-1">Temporary password</label>
        <div class="input-group" style="max-width: 400px;">
            <input id="tempPasswordField" type="text" class="form-control" value="@TempData["TemporaryPassword"]" readonly />
            <button id="copyTempPasswordBtn" type="button" class="btn btn-outline-secondary" data-clipboard-target="#tempPasswordField">
                <i class="bi bi-clipboard"></i> Copy to Clipboard
            </button>
        </div>
        <small class="text-muted d-block mt-1">This password is shown once. The user will be required to change it on next login.</small>
    </div>
}
<dl>
    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Status</dt>
    <dd>@(Model.IsActive ? "Active" : "Suspended")</dd>

    <dt>Created At</dt>
    <dd>@Model.CreatedAt.ToString("g")</dd>

    <dt>Last Login</dt>
    <dd>@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("g") : "Never logged in")</dd>
</dl>
<h4>Group Memberships</h4>
@if (!Model.Groups.Any())
{
    <p>This user is not assigned to any groups yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>App</th>
                <th>Group</th>
                <th>Power Level</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model.Groups)
            {
                <tr>
                    <td>@g.AppName</td>
                    <td>@g.GroupName</td>
                    <td>@g.Level</td>
                </tr>
            }
        </tbody>
    </table>
}
<button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
    <i class="bi bi-key-fill"></i> Reset Password
</button><a asp-action="Index">Back to Users</a>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPasswordModalLabel">Confirm Password Reset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to reset the password for this user?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-warning">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const copyBtn = document.getElementById('copyTempPasswordBtn');
        if (copyBtn) {
            copyBtn.addEventListener('click', function() {
                const field = document.querySelector(this.dataset.clipboardTarget);
                if (!field) return;

                navigator.clipboard.writeText(field.value).then(() => {
                    const originalHtml = copyBtn.innerHTML;
                    copyBtn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
                    copyBtn.classList.add('btn-success');
                    copyBtn.classList.remove('btn-outline-secondary');

                    setTimeout(() => {
                        copyBtn.innerHTML = originalHtml;
                        copyBtn.classList.remove('btn-success');
                        copyBtn.classList.add('btn-outline-secondary');
                    }, 1500);
                }).catch(() => {
                    field.select();
                    document.execCommand('copy');
                });
            });
        }
    </script>
}
