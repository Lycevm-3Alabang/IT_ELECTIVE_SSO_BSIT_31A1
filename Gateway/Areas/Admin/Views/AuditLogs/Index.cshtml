@model IEnumerable<Models.Entities.AuditLog>

<h2>Audit Logs</h2>

<form method="get" asp-action="Index" class="mb-3">
    <label>From: <input type="date" name="from" value="@ViewBag.From" /></label>
    <label>To: <input type="date" name="to" value="@ViewBag.To" /></label>
    <button type="submit">Filter</button>
    <a asp-action="Index">Clear</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Timestamp</th>
            <th>UserId</th>
            <th>Action</th>
            <th>Details</th>
            <th>IP Address</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToString("g")</td>
                <td>@log.UserId</td>
                <td>@log.Action</td>
                <td>@log.Details</td>
                <td>@log.IpAddress</td>
            </tr>
        }
    </tbody>
</table>

<div>
    @if (ViewBag.CurrentPage > 1)
    {
        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Previous</a>
    }
    <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
    {
        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Next</a>
    }
</div>