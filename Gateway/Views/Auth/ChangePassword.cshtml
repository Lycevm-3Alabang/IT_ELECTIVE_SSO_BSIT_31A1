@{
    ViewData["Title"] = "Change password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | IT ELECTIVE - SSO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <main class="auth-panel">
            <div class="auth-card">
                <h2>Set a new password</h2>
                <div class="auth-subtitle">You signed in with a temporary password. Choose a new one to continue.</div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert" role="alert">
                        <strong class="auth-alert-title">Could not change password</strong>
                        <ul class="auth-alert-list">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <label for="currentPassword" class="form-label">Temporary password</label>
                    <input type="password" id="currentPassword" name="currentPassword" class="form-control"
                           autocomplete="current-password" autofocus required />

                    <label for="newPassword" class="form-label">New password</label>
                    <input type="password" id="newPassword" name="newPassword" class="form-control"
                           autocomplete="new-password" required />

                    <label for="confirmPassword" class="form-label">Confirm new password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control"
                           autocomplete="new-password" required />

                    <button type="submit" class="btn btn-auth mt-3">Change password</button>
                </form>

                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                    <button type="submit" class="btn btn-link p-0">Sign out</button>
                </form>
            </div>
        </main>
    </div>
</body>
</html>